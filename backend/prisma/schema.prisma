generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum FieldType {
  // 常规
  TEXT
  NUMBER
  DATE
  SINGLE_SELECT
  MULTI_SELECT
  USER
  GROUP
  ATTACHMENT
  CHECKBOX
  URL
  FORMULA
  LOOKUP
  // 业务
  WORKFLOW
  BUTTON
  AUTO_NUMBER
  PHONE
  EMAIL
  LOCATION
  BARCODE
  PROGRESS
  CURRENCY
  RATING
  // 高级
  LINK_BIDIRECTIONAL
  LINK_UNIDIRECTIONAL
  CREATED_BY
  UPDATED_BY
  CREATED_TIME
  UPDATED_TIME
}

enum ViewType {
  GRID
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  WorkspaceMember[]
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   WorkspaceMember[]
  bases     Base[]
}

model WorkspaceMember {
  id          String         @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole  @default(EDITOR)
  createdAt   DateTime       @default(now())

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model Base {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tables      Table[]

  @@index([workspaceId])
}

model Table {
  id        String   @id @default(uuid())
  baseId    String
  name      String
  rowHeight Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  base      Base     @relation(fields: [baseId], references: [id], onDelete: Cascade)
  fields    Field[]
  views     View[]
  records   Record[]

  @@index([baseId])
}

model Field {
  id        String    @id @default(uuid())
  tableId   String
  name      String
  type      FieldType
  required  Boolean   @default(false)
  options   Json?     // e.g. select options: {choices:[{id,label,color?}]}
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  table     Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

model View {
  id        String   @id @default(uuid())
  tableId   String
  name      String
  type      ViewType @default(GRID)
  config    Json?    // {visibleFieldIds:[], sort:[...], filter:[...], groupBy:...}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table     Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

model Record {
  id        String   @id @default(uuid())
  tableId   String
  data      Json     @default("{}")
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  table     Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@index([deletedAt])
}
